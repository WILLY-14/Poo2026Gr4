<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="login-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.LoginController">
   <children>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxWidth="380.0" spacing="12.0" styleClass="login-card">
               <children>
                  <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/secrecy-icon.png" />
                     </image>
                  </ImageView>
                  <Label styleClass="login-title" text="ElectroVentas" />
                  <Label styleClass="login-sub" text="Inicia sesión para continuar" />
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="field-label" text="USUARIO" />
                        <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="field-label" text="CLAVE" />
                        <PasswordField fx:id="txtClave" onAction="#login" promptText="Ingrese su clave" />
                     </children>
                  </VBox>
                  <HBox spacing="10.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#login" styleClass="btn btn-primary" text="Ingresar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#logout" styleClass="btn btn-secondary" text="Cerrar" HBox.hgrow="ALWAYS" />
                     </children>
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
