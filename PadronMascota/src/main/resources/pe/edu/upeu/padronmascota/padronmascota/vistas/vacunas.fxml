<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pantalla CRUD: formulario a la izquierda, buscador y tabla a la derecha -->
<BorderPane styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.padronmascota.padronmascota.controlador.VacunaController">

   <top>
      <!-- Encabezado: igual en todas las pantallas -->
      <HBox styleClass="encabezado">
         <BorderPane.margin><Insets bottom="14.0" /></BorderPane.margin>
         <StackPane styleClass="encabezado-icono">
            <SVGPath content="M12 2 C8 8 5.5 11.2 5.5 14.5 a6.5 6.5 0 0 0 13 0 C18.5 11.2 16 8 12 2 z M11 11 h2 v2.5 h2.5 v2 H13 V18 h-2 v-2.5 H8.5 v-2 H11 z" fill="WHITE" scaleX="1.05" scaleY="1.05" />
         </StackPane>
         <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
            <Label styleClass="encabezado-titulo" text="%opcion.vacunas" />
            <Label styleClass="encabezado-subtitulo" text="%sub.vacunas" />
         </VBox>
      </HBox>
   </top>

   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-formulario">
      <VBox spacing="10.0" prefWidth="370.0" styleClass="panel-formulario">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="20.0" />
         </padding>
         <Label fx:id="lblModo" styleClass="titulo" wrapText="true" minHeight="-Infinity" />
         <GridPane hgap="8.0" vgap="9.0">
            <columnConstraints>
               <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="%comun.nombre" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="%mascota.especie" GridPane.rowIndex="1" />
            <ComboBox fx:id="cboEspecie" maxWidth="Infinity" promptText="%comun.elegir" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="%vacuna.producto" GridPane.rowIndex="2" />
            <ComboBox fx:id="cboProducto" maxWidth="Infinity" promptText="%comun.elegir" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </GridPane>
         <HBox spacing="8.0">
            <Button onAction="#guardar" styleClass="btn, btn-exito" text="%comun.guardar" defaultButton="true" minWidth="-Infinity" />
            <Button onAction="#nuevo" styleClass="btn, btn-secundario" text="%comun.nuevo" minWidth="-Infinity" />
         </HBox>
      </VBox>
      </ScrollPane>
   </left>

   <center>
      <VBox spacing="10.0" styleClass="panel-tabla">
         <padding><Insets bottom="12.0" left="14.0" right="14.0" top="14.0" /></padding>
         <BorderPane.margin>
            <Insets left="14.0" />
         </BorderPane.margin>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" prefWidth="240.0" promptText="%vacuna.buscar" />
         </HBox>
         <TableView fx:id="tabla" VBox.vgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" />
      </VBox>
   </center>
</BorderPane>
