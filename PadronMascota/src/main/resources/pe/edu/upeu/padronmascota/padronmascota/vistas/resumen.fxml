<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- La tabla "Resumen" del Excel: las tarjetas se crean desde ResumenController -->
<ScrollPane fitToWidth="true" styleClass="scroll-transparente" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.padronmascota.padronmascota.controlador.ResumenController">
   <VBox spacing="12.0">
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
      </padding>
      <!-- Encabezado: igual en todas las pantallas -->
      <HBox styleClass="encabezado">
         <StackPane styleClass="encabezado-icono">
            <SVGPath content="M12 12.5 c-3 0 -6.5 3.2 -6.5 6 c0 1.8 1.4 2.8 3.2 2.8 c1.3 0 2.2 -0.7 3.3 -0.7 c1.1 0 2 0.7 3.3 0.7 c1.8 0 3.2 -1 3.2 -2.8 c0 -2.8 -3.5 -6 -6.5 -6 z M2.5 10.5 a2.2 2.7 0 1 0 4.4 0 a2.2 2.7 0 1 0 -4.4 0 z M6.6 5.5 a2.3 2.9 0 1 0 4.6 0 a2.3 2.9 0 1 0 -4.6 0 z M12.8 5.5 a2.3 2.9 0 1 0 4.6 0 a2.3 2.9 0 1 0 -4.6 0 z M17.1 10.5 a2.2 2.7 0 1 0 4.4 0 a2.2 2.7 0 1 0 -4.4 0 z" fill="WHITE" scaleX="1.05" scaleY="1.05" />
         </StackPane>
         <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
            <Label styleClass="encabezado-titulo" text="%opcion.resumen" />
            <Label styleClass="encabezado-subtitulo" text="%sub.resumen" />
         </VBox>
         <Button onAction="#actualizar" styleClass="btn, btn-primario" text="%resumen.actualizar" />
      </HBox>

      <Label styleClass="subtitulo" text="%resumen.seccionPadron" />
      <FlowPane fx:id="panelPadron" hgap="12.0" vgap="12.0" />

      <Label styleClass="subtitulo" text="%resumen.seccionClinica" />
      <FlowPane fx:id="panelClinica" hgap="12.0" vgap="12.0" />

      <Label styleClass="subtitulo" text="%resumen.seccionVentas" />
      <FlowPane fx:id="panelVentas" hgap="12.0" vgap="12.0" />

      <Label styleClass="subtitulo" text="%resumen.seccionCompras" />
      <FlowPane fx:id="panelCompras" hgap="12.0" vgap="12.0" />

      <HBox spacing="16.0" prefHeight="300.0">
         <PieChart fx:id="graficoEspecies" title="%resumen.graficoEspecies" HBox.hgrow="ALWAYS" />
         <PieChart fx:id="graficoVacunacion" title="%resumen.graficoVacunacion" HBox.hgrow="ALWAYS" />
      </HBox>
   </VBox>
</ScrollPane>
