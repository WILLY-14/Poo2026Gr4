<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.padronmascota.padronmascota.controlador.ServicioVeterinarioController">

   <top>
      <!-- Encabezado: igual en todas las pantallas -->
      <HBox styleClass="encabezado">
         <BorderPane.margin><Insets bottom="14.0" /></BorderPane.margin>
         <StackPane styleClass="encabezado-icono">
            <SVGPath content="M6 3 a3 3 0 1 0 0 6 a3 3 0 0 0 0 -6 z M6 15 a3 3 0 1 0 0 6 a3 3 0 0 0 0 -6 z M8.2 8 L21 18.5 L19.6 20 L10.4 12 L8.2 16 L6.8 15 L9.2 11 z M13.4 9.2 L19.6 4 L21 5.5 L14.9 10.5 z" fill="WHITE" scaleX="1.05" scaleY="1.05" />
         </StackPane>
         <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
            <Label styleClass="encabezado-titulo" text="%opcion.servicios" />
            <Label styleClass="encabezado-subtitulo" text="%sub.servicios" />
         </VBox>
      </HBox>
   </top>

   <left>
      <VBox spacing="10.0" prefWidth="340.0" styleClass="panel-formulario">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="20.0" />
         </padding>
         <Label fx:id="lblModo" styleClass="titulo" />
         <GridPane hgap="8.0" vgap="9.0">
            <columnConstraints>
               <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="%comun.nombre" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="%comun.precioSoles" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </GridPane>
         <HBox spacing="8.0">
            <Button onAction="#guardar" styleClass="btn, btn-exito" text="%comun.guardar" defaultButton="true" />
            <Button onAction="#nuevo" styleClass="btn, btn-secundario" text="%comun.nuevo" />
         </HBox>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" styleClass="panel-tabla">
         <padding><Insets bottom="12.0" left="14.0" right="14.0" top="14.0" /></padding>
         <BorderPane.margin>
            <Insets left="14.0" />
         </BorderPane.margin>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="%servicio.buscar" />
         </HBox>
         <TableView fx:id="tblServicios" VBox.vgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" />
      </VBox>
   </center>
</BorderPane>
