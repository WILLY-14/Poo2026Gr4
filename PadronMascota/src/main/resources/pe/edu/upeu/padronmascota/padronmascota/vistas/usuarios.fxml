<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pantalla CRUD: formulario a la izquierda, buscador y tabla a la derecha -->
<BorderPane styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.padronmascota.padronmascota.controlador.UsuarioController">

   <top>
      <!-- Encabezado: igual en todas las pantallas -->
      <HBox styleClass="encabezado">
         <BorderPane.margin><Insets bottom="14.0" /></BorderPane.margin>
         <StackPane styleClass="encabezado-icono">
            <SVGPath content="M7 10 V7 a5 5 0 0 1 10 0 v3 h1 a1 1 0 0 1 1 1 v9 a1 1 0 0 1 -1 1 H6 a1 1 0 0 1 -1 -1 v-9 a1 1 0 0 1 1 -1 z M9 10 h6 V7 a3 3 0 0 0 -6 0 z" fill="WHITE" scaleX="1.05" scaleY="1.05" />
         </StackPane>
         <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
            <Label styleClass="encabezado-titulo" text="%opcion.usuarios" />
            <Label styleClass="encabezado-subtitulo" text="%sub.usuarios" />
         </VBox>
      </HBox>
   </top>

   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-formulario">
      <VBox spacing="10.0" prefWidth="380.0" styleClass="panel-formulario">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="20.0" />
         </padding>
         <Label fx:id="lblModo" styleClass="titulo" wrapText="true" minHeight="-Infinity" />
         <GridPane hgap="8.0" vgap="9.0">
            <columnConstraints>
               <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="%usuario.username" GridPane.rowIndex="0" />
            <TextField fx:id="txtUsername" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="%usuario.clave" GridPane.rowIndex="1" />
            <PasswordField fx:id="txtClave" promptText="%usuario.clavePrompt" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="%usuario.rol" GridPane.rowIndex="2" />
            <ComboBox fx:id="cboRol" maxWidth="Infinity" promptText="%comun.elegir" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="%usuario.veterinario" GridPane.rowIndex="3" />
            <ComboBox fx:id="cboVeterinario" maxWidth="Infinity" promptText="%cita.vetPrompt" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="%usuario.activo" GridPane.rowIndex="5" />
            <CheckBox fx:id="chkActivo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </GridPane>
         <HBox spacing="8.0">
            <Button onAction="#guardar" styleClass="btn, btn-exito" text="%comun.guardar" defaultButton="true" minWidth="-Infinity" />
            <Button onAction="#nuevo" styleClass="btn, btn-secundario" text="%comun.nuevo" minWidth="-Infinity" />
         </HBox>
      </VBox>
      </ScrollPane>
   </left>

   <center>
      <VBox spacing="10.0" styleClass="panel-tabla">
         <padding><Insets bottom="12.0" left="14.0" right="14.0" top="14.0" /></padding>
         <BorderPane.margin>
            <Insets left="14.0" />
         </BorderPane.margin>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" prefWidth="240.0" promptText="%usuario.buscar" />
         </HBox>
         <TableView fx:id="tabla" VBox.vgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" />
      </VBox>
   </center>
</BorderPane>
