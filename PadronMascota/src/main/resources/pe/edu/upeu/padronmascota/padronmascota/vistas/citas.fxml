<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.SVGPath?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Pantalla CRUD: formulario a la izquierda, buscador y tabla a la derecha -->
<BorderPane styleClass="pantalla" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.padronmascota.padronmascota.controlador.CitaController">

   <top>
      <!-- Encabezado: igual en todas las pantallas -->
      <HBox styleClass="encabezado">
         <BorderPane.margin><Insets bottom="14.0" /></BorderPane.margin>
         <StackPane styleClass="encabezado-icono">
            <SVGPath content="M7 2 h2 v2 h6 V2 h2 v2 h2 a2 2 0 0 1 2 2 v14 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 V6 a2 2 0 0 1 2 -2 h2 z M5 9 v11 h14 V9 z M7 11 h4 v4 H7 z" fill="WHITE" scaleX="1.05" scaleY="1.05" />
         </StackPane>
         <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
            <Label styleClass="encabezado-titulo" text="%opcion.citas" />
            <Label styleClass="encabezado-subtitulo" text="%sub.citas" />
         </VBox>
      </HBox>
   </top>

   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-formulario">
      <VBox spacing="10.0" prefWidth="380.0" styleClass="panel-formulario">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="20.0" />
         </padding>
         <Label fx:id="lblModo" styleClass="titulo" wrapText="true" minHeight="-Infinity" />
         <GridPane hgap="8.0" vgap="9.0">
            <columnConstraints>
               <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="%cita.mascota" GridPane.rowIndex="0" />
            <TextField fx:id="txtMascota" promptText="%cita.mascotaPrompt" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <!-- Campos que solo aparecen si lo escrito es nuevo (agrupados para que no dejen huecos) -->
            <GridPane hgap="8.0" vgap="9.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
               <columnConstraints>
                  <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <Label fx:id="lblEspecieNueva" text="%mascota.especie" visible="false" managed="false" GridPane.rowIndex="0" />
               <ComboBox fx:id="cboEspecieNueva" maxWidth="Infinity" promptText="%comun.elegir" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <Label fx:id="lblDueno" text="%mascota.propietario" visible="false" managed="false" GridPane.rowIndex="1" />
               <TextField fx:id="txtDueno" promptText="%mascota.propietarioPrompt" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label fx:id="lblDniDueno" text="%propietario.dni" visible="false" managed="false" GridPane.rowIndex="2" />
               <TextField fx:id="txtDniDueno" promptText="%propietario.dniPrompt" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <Label fx:id="lblTelDueno" text="%propietario.telefono" visible="false" managed="false" GridPane.rowIndex="3" />
               <TextField fx:id="txtTelDueno" promptText="%propietario.telefonoPrompt" visible="false" managed="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
            <Label text="%cita.veterinario" GridPane.rowIndex="2" />
            <ComboBox fx:id="cboVeterinario" maxWidth="Infinity" promptText="%cita.vetPrompt" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="%cita.fecha" GridPane.rowIndex="4" />
            <DatePicker fx:id="dtpFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="%cita.hora" GridPane.rowIndex="5" />
            <TextField fx:id="txtHora" promptText="09:30" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label text="%cita.motivo" GridPane.rowIndex="6" />
            <TextField fx:id="txtMotivo" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <!-- Campos que solo aparecen si lo escrito es nuevo (agrupados para que no dejen huecos) -->
            <GridPane hgap="8.0" vgap="9.0" GridPane.columnSpan="2" GridPane.rowIndex="7">
               <columnConstraints>
                  <ColumnConstraints minWidth="128.0" prefWidth="128.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <Label fx:id="lblNotaNueva" text="%cita.notaNueva" wrapText="true" minHeight="-Infinity" styleClass="texto-suave" visible="false" managed="false" GridPane.columnSpan="2" GridPane.rowIndex="0" />
            </GridPane>
         </GridPane>
         <HBox spacing="8.0">
            <Button onAction="#guardar" styleClass="btn, btn-exito" text="%comun.guardar" defaultButton="true" minWidth="-Infinity" />
            <Button onAction="#nuevo" styleClass="btn, btn-secundario" text="%comun.nuevo" minWidth="-Infinity" />
         </HBox>
      </VBox>
      </ScrollPane>
   </left>

   <center>
      <VBox spacing="10.0" styleClass="panel-tabla">
         <padding><Insets bottom="12.0" left="14.0" right="14.0" top="14.0" /></padding>
         <BorderPane.margin>
            <Insets left="14.0" />
         </BorderPane.margin>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" prefWidth="240.0" promptText="%cita.buscar" />
            <ComboBox fx:id="cboFiltroEstado" onAction="#buscar" prefWidth="120.0" />
         </HBox>
         <TableView fx:id="tabla" VBox.vgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" />
      </VBox>
   </center>
</BorderPane>
